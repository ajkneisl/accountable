{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "paths": {
            "@shared/*": ["../shared/src/*"]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "nativewind-env.d.ts",
        ".expo/types/**/*.ts",
        "expo-env.d.ts",
        "../shared/src/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
