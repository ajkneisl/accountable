{
    "expo": {
        "name": "Accountable",
        "slug": "accountable",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "light",
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.accountable.app",
            "appleTeamId": "CBL6R6SP6A"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#f8f5ef"
            },
            "predictiveBackGestureEnabled": false
        },
        "web": {
            "favicon": "./assets/favicon.png",
            "bundler": "metro",
            "output": "single"
        },
        "plugins": [
            "expo-router",
            [
                "@kingstinct/react-native-healthkit",
                {
                    "NSHealthShareUsageDescription": "Accountable reads your workouts so they count toward your goals.",
                    "NSHealthUpdateUsageDescription": false,
                    "background": true
                }
            ],
            "expo-secure-store",
            "expo-status-bar",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/splash-icon.png",
                    "resizeMode": "contain",
                    "backgroundColor": "#f8f5ef"
                }
            ],
            [
                "expo-widgets",
                {
                    "widgets": [
                        {
                            "name": "HabitsHeatmap",
                            "displayName": "Habits",
                            "description": "Your habit heatmap at a glance.",
                            "ios": {
                                "supportedFamilies": [
                                    "systemSmall",
                                    "systemMedium",
                                    "systemLarge"
                                ]
                            }
                        }
                    ]
                }
            ]
        ],
        "scheme": "accountable",
        "experiments": {
            "typedRoutes": true
        }
    }
}
