{
    "expo": {
        "name": "Beacc",
        "slug": "accountable",
        "version": "1.4.2",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "automatic",
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "app.umn.acc",
            "buildNumber": "49",
            "appleTeamId": "CBL6R6SP6A",
            "associatedDomains": ["applinks:beacc.app"],
            "config": {
                "usesNonExemptEncryption": false
            }
        },
        "android": {
            "package": "app.umn.acc",
            "versionCode": 1,
            "googleServicesFile": "./google-services.json",
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#16100c"
            },
            "predictiveBackGestureEnabled": false,
            "permissions": [
                "android.permission.health.READ_STEPS",
                "android.permission.health.READ_DISTANCE",
                "android.permission.health.READ_SLEEP",
                "android.permission.health.READ_EXERCISE",
                "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
                "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
            ]
        },
        "web": {
            "favicon": "./assets/favicon.png",
            "bundler": "metro",
            "output": "single"
        },
        "plugins": [
            "./plugins/withSceneLifecycle",
            "./plugins/withHabitsWidgetPicker",
            "./plugins/withCompetitionsWidgetPicker",
            "./plugins/withGoalsWidgetPicker",
            "./plugins/withScreenTimeMonitor",
            "./plugins/withReleaseSigning",
            "expo-router",
            [
                "@kingstinct/react-native-healthkit",
                {
                    "NSHealthShareUsageDescription": "Beacc reads your workouts, sleep and steps so they count toward your goals.",
                    "NSHealthUpdateUsageDescription": "Beacc only reads your workouts, sleep and steps. It never writes to Apple Health.",
                    "background": true
                }
            ],
            "expo-secure-store",
            [
                "expo-image-picker",
                {
                    "photosPermission": "Beacc uses your photos so you can choose a profile picture.",
                    "cameraPermission": false,
                    "microphonePermission": false
                }
            ],
            "expo-status-bar",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/splash-icon.png",
                    "resizeMode": "contain",
                    "backgroundColor": "#f8f5ef"
                }
            ],
            [
                "expo-widgets",
                {
                    "widgets": [
                        {
                            "name": "HabitsHeatmap",
                            "displayName": "Habits",
                            "description": "Your habits and their streaks at a glance.",
                            "ios": {
                                "supportedFamilies": [
                                    "systemSmall",
                                    "systemMedium",
                                    "systemLarge"
                                ],
                                "configuration": {
                                    "title": "Habits",
                                    "description": "Choose the habits to show.",
                                    "parameters": {
                                        "habits": {
                                            "title": "Habits",
                                            "type": "string",
                                            "default": ""
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "CompetitionStandings",
                            "displayName": "Competitions",
                            "description": "Where you stand in a competition this week.",
                            "ios": {
                                "supportedFamilies": [
                                    "systemSmall",
                                    "systemMedium",
                                    "systemLarge"
                                ],
                                "configuration": {
                                    "title": "Competition",
                                    "description": "Choose the competition to show.",
                                    "parameters": {
                                        "competition": {
                                            "title": "Competition",
                                            "type": "string",
                                            "default": ""
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "GoalsProgress",
                            "displayName": "Goals",
                            "description": "This week's progress on your goals.",
                            "ios": {
                                "supportedFamilies": [
                                    "systemSmall",
                                    "systemMedium",
                                    "systemLarge"
                                ],
                                "configuration": {
                                    "title": "Goals",
                                    "description": "Choose the goals to show.",
                                    "parameters": {
                                        "goals": {
                                            "title": "Goals",
                                            "type": "string",
                                            "default": ""
                                        }
                                    }
                                }
                            }
                        }
                    ]
                }
            ],
            "expo-background-task",
            "expo-notifications",
            "react-native-health-connect",
            [
                "react-native-android-widget",
                {
                    "widgets": [
                        {
                            "name": "HabitsHeatmap",
                            "label": "Habits",
                            "description": "Your habits and their streaks at a glance.",
                            "minWidth": "110dp",
                            "minHeight": "110dp",
                            "targetCellWidth": 2,
                            "targetCellHeight": 2,
                            "resizeMode": "horizontal|vertical",
                            "updatePeriodMillis": 1800000
                        },
                        {
                            "name": "CompetitionStandings",
                            "label": "Competitions",
                            "description": "Where you stand in a competition this week.",
                            "minWidth": "110dp",
                            "minHeight": "110dp",
                            "targetCellWidth": 2,
                            "targetCellHeight": 2,
                            "resizeMode": "horizontal|vertical",
                            "updatePeriodMillis": 1800000
                        },
                        {
                            "name": "GoalsProgress",
                            "label": "Goals",
                            "description": "This week's progress on your goals.",
                            "minWidth": "110dp",
                            "minHeight": "110dp",
                            "targetCellWidth": 2,
                            "targetCellHeight": 2,
                            "resizeMode": "horizontal|vertical",
                            "updatePeriodMillis": 1800000
                        }
                    ]
                }
            ],
            [
                "expo-build-properties",
                {
                    "android": {
                        "minSdkVersion": 26
                    }
                }
            ]
        ],
        "scheme": "accountable",
        "experiments": {
            "typedRoutes": true
        }
    }
}
