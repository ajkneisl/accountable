{
    "expo": {
        "name": "Beacc",
        "slug": "accountable",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "light",
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "app.umn.acc",
            "buildNumber": "16",
            "appleTeamId": "CBL6R6SP6A",
            "config": {
                "usesNonExemptEncryption": false
            }
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#16100c"
            },
            "predictiveBackGestureEnabled": false
        },
        "web": {
            "favicon": "./assets/favicon.png",
            "bundler": "metro",
            "output": "single"
        },
        "plugins": [
            "./plugins/withSceneLifecycle",
            "./plugins/withHabitsWidgetPicker",
            "./plugins/withCompetitionsWidgetPicker",
            "./plugins/withGoalsWidgetPicker",
            "./plugins/withScreenTimeMonitor",
            "expo-router",
            [
                "@kingstinct/react-native-healthkit",
                {
                    "NSHealthShareUsageDescription": "Beacc reads your workouts, sleep and steps so they count toward your goals.",
                    "NSHealthUpdateUsageDescription": "Beacc only reads your workouts, sleep and steps. It never writes to Apple Health.",
                    "background": true
                }
            ],
            "expo-secure-store",
            "expo-status-bar",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/splash-icon.png",
                    "resizeMode": "contain",
                    "backgroundColor": "#f8f5ef"
                }
            ],
            [
                "expo-widgets",
                {
                    "widgets": [
                        {
                            "name": "HabitsHeatmap",
                            "displayName": "Habits",
                            "description": "Your habits and their streaks at a glance.",
                            "ios": {
                                "supportedFamilies": [
                                    "systemSmall",
                                    "systemMedium",
                                    "systemLarge"
                                ],
                                "configuration": {
                                    "title": "Habits",
                                    "description": "Choose the habits to show.",
                                    "parameters": {
                                        "habits": {
                                            "title": "Habits",
                                            "type": "string",
                                            "default": ""
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "CompetitionStandings",
                            "displayName": "Competitions",
                            "description": "Where you stand in a competition this week.",
                            "ios": {
                                "supportedFamilies": [
                                    "systemSmall",
                                    "systemMedium",
                                    "systemLarge"
                                ],
                                "configuration": {
                                    "title": "Competition",
                                    "description": "Choose the competition to show.",
                                    "parameters": {
                                        "competition": {
                                            "title": "Competition",
                                            "type": "string",
                                            "default": ""
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "GoalsProgress",
                            "displayName": "Goals",
                            "description": "This week's progress on your goals.",
                            "ios": {
                                "supportedFamilies": [
                                    "systemSmall",
                                    "systemMedium",
                                    "systemLarge"
                                ],
                                "configuration": {
                                    "title": "Goals",
                                    "description": "Choose the goals to show.",
                                    "parameters": {
                                        "goals": {
                                            "title": "Goals",
                                            "type": "string",
                                            "default": ""
                                        }
                                    }
                                }
                            }
                        }
                    ]
                }
            ],
            "expo-background-task",
            "expo-notifications"
        ],
        "scheme": "accountable",
        "experiments": {
            "typedRoutes": true
        }
    }
}
