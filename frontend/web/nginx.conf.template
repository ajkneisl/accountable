server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Proxy API calls to the backend. ${API_UPSTREAM} is filled in by the nginx
    # image's envsubst step at startup: "backend:8080" under docker compose,
    # "127.0.0.1:8080" on ECS where both containers share the task's network.
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback: let client-side routing handle unknown paths.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
